<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

	<PropertyGroup>
		<!--
			Make sure any documentation comments which are included in code get checked for syntax during the build, but do
			not report warnings for missing comments.

			CS1573: Parameter 'parameter' has no matching param tag in the XML comment for 'parameter' (but other parameters do)
			CS1591: Missing XML comment for publicly visible type or member 'Type_or_Member'
		-->
		<DocumentationFile></DocumentationFile>
	</PropertyGroup>

    <ItemGroup>
        <!-- Packed as the package's licence, not as content, so it isn't copied into projects that use it. -->
        <None Include="..\Licence.txt" Link="Licence.txt" Pack="true" PackagePath="\" />
        <None Include="..\README.md" Link="README.md" Pack="true" PackagePath="\" />
        <None Include="icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\ContributorLicenceAgreement.md" Link="ContributorLicenceAgreement.md" />
    </ItemGroup>

    <!-- The release workflow sets Version from the release tag, so this is only the default for local builds. -->
    <PropertyGroup>
        <Authors>Ryan O'Neill, David A. Knight, Grant Winney</Authors>
        <Company>GeneGenie.com</Company>
        <Copyright>Copyright (c) GeneGenie.com</Copyright>
        <Description>A .NET library for loading, saving, working with and analysing family trees stored in GEDCOM files. It reads GEDCOM 5.5.1, along with parts of GEDCOM 7, and writes GEDCOM 5.5.1.</Description>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageLicenseFile>Licence.txt</PackageLicenseFile>
        <PackageProjectUrl>https://genegenie.com</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>https://github.com/TheGeneGenieProject/GeneGenie.Gedcom/releases</PackageReleaseNotes>
        <PackageTags>gedcom genegenie gene genie parser genealogy family tree</PackageTags>
        <Product>GeneGenie.Gedcom</Product>
        <RepositoryUrl>https://github.com/TheGeneGenieProject/GeneGenie.Gedcom</RepositoryUrl>
        <Version>2.0.0</Version>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <CodeAnalysisRuleSet />
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <CodeAnalysisRuleSet />
    </PropertyGroup>

    <!-- Source Link is built into the .NET SDK, so it needs no package reference. Embed the sources that
         aren't in git, such as generated files, so debuggers can still step into them. -->
    <PropertyGroup>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

</Project>
